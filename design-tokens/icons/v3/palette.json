  "geometryOverrides": {
    "$comment": "Corrections for clearly-broken v2 geometry (Codex artifacts). Each entry fully replaces the icon's nodes in v3 only; v2 registry.json is never modified. Removing an entry reverts v3 to faithful v2 derivation. See reports/plantim-icons-v3-report.pdf.",
    "weather.sun": {
      "reason": "v2 stored all 8 sun rays as zero-length dots (d=\"M12 4h.01\"), so the sun rendered as a dotted ring with no rays. Restored to correct Lucide ray strokes.",
