{
  "name": "@plantim/icons",
  "version": "2.1.0",
  "private": false,
  "description": "Plantim's cross-platform semantic icon library.",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senioritas/plantim-icons.git",
    "directory": "packages/plantim-icons"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js",
      "default": "./dist/navigation.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "vue": ["dist/vue.d.ts"],
      "metadata": ["dist/metadata.d.ts"],
      "navigation": ["dist/navigation.d.ts"],
      "*": ["dist/index.d.ts"]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node ../../design-tokens/bin/generate-icons.mjs && node ../../design-tokens/bin/generate-swift-icons.mjs",
    "build": "node ../../design-tokens/bin/clean-icon-package.mjs && tsc -p tsconfig.json",
    "prepare": "npm run generate && npm run build",
    "prepublishOnly": "npm run generate && npm run build && npm run check && npm run check:package && npm run check:api && npm run check:size",
    "check": "node ../../design-tokens/bin/check-icon-contract.mjs",
    "check:package": "node ../../design-tokens/bin/check-npm-package.mjs",
    "check:api": "node ../../design-tokens/bin/check-icon-package-api.mjs",
    "check:size": "node ../../design-tokens/bin/check-icon-package-size.mjs",
    "check:migrations": "node ../../design-tokens/bin/check-icon-migrations.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vue": "^3.5.32"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
