{
  "name": "plantim-icons-workspace",
  "private": true,
  "description": "Plantim open-source cross-platform semantic icon library workspace.",
  "license": "MIT",
  "workspaces": [
    "design-tokens",
    "packages/plantim-icons"
  ],
  "scripts": {
    "icons:generate": "node design-tokens/bin/generate-icons.mjs && node design-tokens/bin/generate-swift-icons.mjs && npm --prefix packages/plantim-icons run build",
    "icons:check": "node design-tokens/bin/check-icon-contract.mjs",
    "icons:test": "node design-tokens/bin/test-icon-registry.mjs",
    "icons:accessibility": "node design-tokens/bin/check-icon-accessibility.mjs",
    "icons:galleries": "node design-tokens/bin/check-icon-galleries.mjs",
    "icons:package:check": "node design-tokens/bin/check-npm-package.mjs",
    "icons:package:api": "node design-tokens/bin/check-icon-package-api.mjs",
    "icons:package:size": "node design-tokens/bin/check-icon-package-size.mjs",
    "icons:migrations": "node design-tokens/bin/generate-icon-migrations.mjs",
    "icons:migrations:check": "node design-tokens/bin/check-icon-migrations.mjs",
    "icons:vue:test": "node design-tokens/bin/test-icon-vue-api.mjs",
    "icons:compatibility": "node design-tokens/bin/check-package-compatibility.mjs",
    "icons:release:check": "node design-tokens/bin/check-release-governance.mjs",
    "gallery:dev": "vite --config gallery/web/vite.config.ts",
    "gallery:build": "vite build --config gallery/web/vite.config.ts",
    "gallery:test": "playwright test gallery/web/gallery.spec.ts",
    "icons:validate:node": "npm run icons:generate && npm run icons:migrations && npm run icons:check && npm run icons:migrations:check && npm run icons:test && npm run icons:accessibility && npm run icons:galleries && npm run icons:vue:test && npm run icons:compatibility && npm run icons:release:check && npm run icons:package:check && npm run icons:package:api && npm run icons:package:size",
    "icons:validate": "npm run icons:validate:node && swift test --package-path packages/PlantimIcons",
    "icons:publish:dry-run": "npm publish --workspace packages/plantim-icons --dry-run --access public",
    "icons:v3": "node design-tokens/bin/generate-v3-icons.mjs && node design-tokens/bin/check-v3-icons.mjs",
    "icons:v3:pdf": "node design-tokens/bin/generate-v3-report.mjs && node design-tokens/bin/generate-v3-catalog.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "@lucide/vue": "1.33.0",
    "@playwright/test": "1.59.1",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "^6.0.2",
    "vite": "8.0.8",
    "vue": "^3.5.32"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11.12.1"
  },
  "packageManager": "npm@11.12.1"
}
